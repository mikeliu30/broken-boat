          <th>方案</th>
          <th>登录方式</th>
          <th>Reaction</th>
          <th>部署复杂度</th>
      </tr>
  </thead>
  <tbody>
      <tr>
          <td>Giscus</td>
          <td>仅 GitHub</td>
          <td>✅</td>
          <td>简单</td>
      </tr>
      <tr>
          <td>Utterances</td>
          <td>仅 GitHub</td>
          <td>❌</td>
          <td>简单</td>
      </tr>
      <tr>
          <td><strong>Waline</strong></td>
          <td><strong>GitHub + Google 等</strong></td>
          <td><strong>✅</strong></td>
